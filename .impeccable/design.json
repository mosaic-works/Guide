  "narrative": {
    "northStar": "The System-Aware Exhibition Folio",
    "overview": "Awareness is a practical Vietnamese guide presented as a calm editorial document. Warm Editorial follows the visitor's operating-system appearance through CSS. The 60/30/10 relationship gives the canvas, card plane, and accent separate jobs; lightness reverses between light and dark appearances.",
    "keyCharacteristics": [
      "Warm Editorial default with two hidden CSS palette configurations.",
      "System-aware light and dark tokens for canvas, card, hover, accent, text, and border.",
      "A flat account section and lightly separated Awareness and closing surfaces.",
      "Light QR backing in both appearances for scanner readability."
    ],
    "rules": [
      {
        "name": "The Lightness Mirror Rule",
        "body": "Keep the hue family stable while the canvas, card, hover, and accent reverse their lightness hierarchy.",
        "section": "colors"
      },
      {
        "name": "The Contrast Rule",
        "body": "Primary text must exceed 10:1 on canvas and card; actions use their matching on-accent token.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use semantic roles for appearance-sensitive colors.",
      "Do keep the automatic system preference hidden from the visible interface.",
      "Do keep QR artwork on a light backing."
    ],
    "donts": [
      "Don't invert images or QR artwork.",
      "Don't use pure white or pure black as broad page surfaces.",
      "Don't use a gradient for the account section."
    ]
  }
