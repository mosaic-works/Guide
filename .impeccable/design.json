      "refersTo": "button-primary-light",
      "description": "System-aware high priority action.",
      "html": "<a class=\"ds-cta\" href=\"#\">Mở website Awareness</a>",
      "css": ".ds-cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 20px;border-radius:10px;color:var(--on-accent,#FFFDF9);background:var(--accent,#B5563C);font:700 .92rem/1.2 Aptos,\"Segoe UI\",sans-serif;text-decoration:none;transition:transform 220ms cubic-bezier(.16,1,.3,1),filter 220ms ease}.ds-cta:hover{transform:translateY(-3px);filter:brightness(1.08)}.ds-cta:focus-visible{outline:3px solid var(--accent,#B5563C);outline-offset:4px}"
    },
    {
      "name": "Secondary Action",
      "kind": "button",
      "description": "Card-toned supporting action.",
      "html": "<a class=\"ds-secondary\" href=\"#\">Xem thư viện QR</a>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 20px;border:1px solid var(--line,#DCD5C9);border-radius:10px;color:var(--ink,#23201D);background:var(--card,#EAE4DA);font:700 .92rem/1.2 Aptos,\"Segoe UI\",sans-serif;text-decoration:none}.ds-secondary:hover{color:var(--on-accent,#FFFDF9);background:var(--accent,#B5563C);border-color:var(--accent,#B5563C)}.ds-secondary:focus-visible{outline:3px solid var(--accent,#B5563C);outline-offset:4px}"
    },
